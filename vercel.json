{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/archive",
      "destination": "/archive.html"
    },
    {
      "source": "/search",
      "destination": "/search.html"
    },
    {
      "source": "/submit",
      "destination": "/submit.html"
    },
    {
      "source": "/appeals",
      "destination": "/appeals.html"
    },
    {
      "source": "/analytics",
      "destination": "/analytics.html"
