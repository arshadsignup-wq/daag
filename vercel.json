    {
      "source": "/blog/what-a-confession-does-not-settle",
      "destination": "/blog/what-a-confession-does-not-settle.html"
    },
    {
      "source": "/blog/where-to-report-online-abuse-in-bangladesh",
      "destination": "/blog/where-to-report-online-abuse-in-bangladesh.html"
    },
    {
      "source": "/blog/who-the-accused-usually-is",
      "destination": "/blog/who-the-accused-usually-is.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/archive.html",
      "destination": "/archive",
      "permanent": true
    },
    {
      "source": "/search.html",
      "destination": "/search",
      "permanent": true
    },
    {
      "source": "/submit.html",
      "destination": "/submit",
      "permanent": true
    },
