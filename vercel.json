    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/180-days-in-law-three-years-in-practice",
      "destination": "/blog/180-days-in-law-three-years-in-practice.html"
    },
    {
      "source": "/blog/what-the-comments-do-after-a-verdict",
